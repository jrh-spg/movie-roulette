# Base URL of your Jellyfin server, reachable from the Docker host/network.
JELLYFIN_URL=http://192.168.1.10:8096

# API key generated under Jellyfin Dashboard > Advanced > API Keys
JELLYFIN_API_KEY=changeme

# Optional: scope all queries to a specific Jellyfin user (find the GUID in
# the dashboard's "Users" page URL). Leave unset to query the whole server.
# JELLYFIN_USER_ID=

# Required for "You might also like" suggestions on the spun movie. Get a
# free API key (the "API Key (v3 auth)" value) at
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=changeme
